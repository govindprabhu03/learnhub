# Copy to .env. Without a key LearnHub runs in offline mode (extractive summaries, cloze quizzes, excerpt answers).
ANTHROPIC_API_KEY=
# Cheap + fast default. Use claude-sonnet-5-5 for higher-quality tutoring.
LEARNHUB_MODEL=claude-haiku-4-5-20251001
# LEARNHUB_TUTOR_MODEL=claude-sonnet-5-5

# Database. Leave empty for a local SQLite file (data/learnhub.db). Or use Postgres + pgvector:
#   DATABASE_URL=postgresql://user:password@host:5432/learnhub     (any Postgres 13+ with the pgvector extension)
#   DATABASE_URL=embedded                                           (zero-install local Postgres, needs `pip install pgserver`)
# The schema is created/upgraded automatically on startup by Alembic.
DATABASE_URL=

# --- operations ---
# SECRET_KEY=              signs login/verify/reset tokens. REQUIRED when several containers run (they must share it); docker compose enforces it.
# WORKER_MODE=inline       inline: document-processing workers run inside the web process. external: run `python backend/worker.py` separately.
# WORKER_THREADS=2
# SENTRY_DSN=              error reporting; off when empty
# ENVIRONMENT=development
# POSTGRES_PASSWORD=learnhub   (docker compose only)

# Public address of the app: used in emailed links and as the Google redirect (must be https in production)
APP_URL=http://localhost:8100

# Email (verification + password reset). Leave SMTP_HOST empty in development: emails are printed to the server console.
# With SMTP_HOST set, new accounts must verify their email before they can log in (override: REQUIRE_VERIFIED_EMAIL=0/1).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# REQUIRE_VERIFIED_EMAIL=auto

# "Continue with Google" (button appears only when both are set). Setup steps are in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
